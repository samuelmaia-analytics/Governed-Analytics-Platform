# Example environment variables.
# The project runs locally without mandatory secrets. Keep real credentials only in .env.

# Local runtime
PROJECT_NAME=Governed Analytics Platform
ENVIRONMENT=local
DATABASE_URL=

# Dadosfera Maestro API
DADOSFERA_ENABLED=false
DADOSFERA_MAESTRO_BASE_URL=https://maestro.dadosfera.ai
DADOSFERA_ACCESS_TOKEN=
DADOSFERA_API_TOKEN=
DADOSFERA_USERNAME=
DADOSFERA_PASSWORD=
DADOSFERA_TOTP=
DADOSFERA_PIPELINE_LIST_ENDPOINT=/platform/pipelines
DADOSFERA_PIPELINE_CREATE_ENDPOINT=/platform/pipeline
DADOSFERA_PIPELINE_GET_ENDPOINT_TEMPLATE=/platform/pipeline/{pipeline_id}
DADOSFERA_PIPELINE_RUN_ENDPOINT=/platform/pipeline/execute
DADOSFERA_PIPELINE_RUNS_ENDPOINT_TEMPLATE=/platform/pipeline/{pipeline_id}/pipeline_run

# OpenAI API
OPENAI_ENABLED=false
OPENAI_API_KEY=

# n8n orchestration
# Set PROJECT_ROOT_DIR when n8n runs outside the repository working directory.
PROJECT_ROOT_DIR=
N8N_PIPELINE_CONFIG=config/pipeline_config.yml
N8N_WEBHOOK_URL=
N8N_API_KEY=

# Alerts
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=PUBLIC

# Logging
LOG_FORMAT=csv
LOG_FILE=logs/pipeline_execution_logs.csv
